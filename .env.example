# =============================================================================
# terreno.com.py — environment variables
# Copy to `.env.local` for development. The site BUILDS AND RUNS on the
# "MINIMUM VIABLE" subset alone; every other var degrades gracefully when unset.
# =============================================================================

# --- MINIMUM VIABLE (Build 1 runs on these alone) ---------------------------
NEXT_PUBLIC_SITE_URL=https://terreno.com.py
NEXT_PUBLIC_WHATSAPP=595981000000          # OUR number: casa_propia + valuation + service leads
NEXT_PUBLIC_BUSINESS_NAME=Terreno
NEXT_PUBLIC_FEATURE_FEATURED_BADGES=true   # visual only at launch (featured_until gating)

# --- PENDING (leave empty; features self-disable when empty) ----------------
GHL_WEBHOOK_URL=                           # GoHighLevel inbound webhook for lead fan-out
SHEETS_WEBHOOK_URL=                        # Google Sheets (Apps Script) backup webhook
REVALIDATE_TOKEN=                          # shared secret for /api/revalidate (Phase 2 ISR)

# --- PHASE 2 (JetEngine backend; unused in Build 1) -------------------------
JETENGINE_API_BASE=                        # https://panel.terreno.com.py/wp-json/...
JETENGINE_APP_USER=                        # WordPress user
JETENGINE_APP_PASSWORD=                    # WP Application Password (not OAuth)
