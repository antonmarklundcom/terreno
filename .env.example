# =============================================================================
# terreno.com.py — environment variables
# Copy to `.env.local` for development. The site BUILDS AND RUNS on the
# "MINIMUM VIABLE" subset alone; every other var degrades gracefully when unset.
# Full env contract: ARCHITECTURE.md §10.
# =============================================================================

# --- MINIMUM VIABLE (M0 site runs on these alone) ---------------------------
NEXT_PUBLIC_SITE_URL=https://terreno.com.py
NEXT_PUBLIC_WHATSAPP=595981000000          # OUR number: casa_propia + valuation + service leads
NEXT_PUBLIC_BUSINESS_NAME=Terreno
NEXT_PUBLIC_FEATURE_FEATURED_BADGES=true   # visual only at launch (featured_until gating)

# --- M1 (own MySQL DB via Drizzle; seed stays the permanent fallback) -------
DATABASE_URL=                              # mysql://terreno_user:…@localhost/terreno_prod

# --- LEADS / ISR (leave empty; features self-disable when empty) ------------
GHL_WEBHOOK_URL=                           # GoHighLevel inbound webhook for lead fan-out (M4)
SHEETS_WEBHOOK_URL=                        # Google Sheets (Apps Script) backup webhook
REVALIDATE_TOKEN=                          # shared secret for /api/revalidate (on-demand ISR)

# --- M2/M3 cross-posting sync (deferred; documented in ARCHITECTURE.md §5) ---
# PROPIA_FEED_URL=https://propia.com.py/api/feed/terreno
# FEED_SHARED_SECRET=                       # same secret both directions
# SYNC_TOKEN=                               # cron → /api/sync/import
